# AI provider: anthropic | openai | lm_studio
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
LM_STUDIO_BASE_URL=http://localhost:1234/v1
LM_STUDIO_API_KEY=

# Optional PostgreSQL persistence
DATABASE_URL=

# Local development storage
AGENT_DB_SQLITE_PATH=agent_platform_data.sqlite3
AGENT_FILES_DIR=agent_platform_files

# Frontend origins allowed by the API
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Gmail OAuth (only if configuring Gmail integration)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/credentials/oauth/gmail/callback

# Set to 1 to disable the background scheduler
DISABLE_SCHEDULER=0
